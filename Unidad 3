const { visualid } = createParams('visualid')
setcps(140/60/4)
 
let vocal = note("bb4 c5 d5 f5")
  .s("square")
  .gain(0.4)
  .sustain(0.4)
  .crush(4)
  .delay(0.3).delaytime(0.15)
  .room(0.4)
  .visualid("vocal")
$vocal: stack(vocal, vocal.osc())
 
let pluck = note("<g4*4 f4*4 eb4*4 f4*4>")
  .s("sawtooth")
  .gain(0.35)
  .decay(0.15)
  .lpf(1500)
  .pan(sine.range(0.2, 0.8).slow(2))
  .visualid("pluck")
$pluck: stack(pluck, pluck.osc())
 
let swell = note("<[g3,bb3,d4] [f3,a3,c4] [eb3,g3,bb3] [f3,a3,c4]>")
  .s("sawtooth")
  .gain(0.35)
  .lpf(sine.range(400, 2500).slow(4))
  .jux(rev)
  .visualid("swell")
$swell: stack(swell, swell.osc())
 
let drums = sound("<[bd:2 sd:1 bd:2 sd:1] [bd:2 sd:1 bd:2 sd:1]>")
  .bank("RolandTR909")
  .gain(0.85)
  .chop("<1 1 1>")
  .visualid("drums")
$drums: stack(drums, drums.osc())
 
let bass = note("<g2 f2 eb2 f2>")
  .s("triangle")
  .gain(1.1)
  .lpf(400)
  .visualid("bass")
$bass: stack(bass, bass.osc())
